API_TITLE=Auth0 Management API
API_VERSION=v1
DEBUG=True

# JWT Configuration
JWT_SECRET_KEY=xxxxxx
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Auth0 Configuration
AUTH0_DOMAIN=dev-xxxxx.us.auth0.com
AUTH0_API_AUDIENCE=https://dev-xxxxx.us.auth0.com/api/v2/
AUTH0_CLIENT_ID=xxxxxxxx
AUTH0_CLIENT_SECRET=xxxxxxx-xxxxxxx
#AUTH0_MANAGEMENT_TOKEN=

# Auth Provider
AUTH_PROVIDER=auth0
